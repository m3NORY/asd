x = int(input())

numbers = []

k = 0
while 3**k <= x:
    l = 0
    while 3**k * 5**l <= x:
        m = 0
        while 3**k * 5**l * 7**m <= x:
            n = 3**k * 5**l * 7**m
            numbers.append(n)
            m += 1
        l += 1
    k += 1

numbers.sort()

for n in numbers:
    print(n)
