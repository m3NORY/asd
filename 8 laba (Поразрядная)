def radix_sort(arr):
    max_num = max(arr)

    exp = 1

    while max_num // exp > 0:
        output = [0] * len(arr)
        count = [0] * 10

        for num in arr:
            digit = (num // exp) % 10
            count[digit] += 1

        for i in range(1, 10):
            count[i] += count[i - 1]

        for i in range(len(arr) - 1, -1, -1):
            digit = (arr[i] // exp) % 10
            output[count[digit] - 1] = arr[i]
            count[digit] -= 1

        arr[:] = output
        exp *= 10

    return arr


arr = list(map(int, input("Введите числа через пробел: ").split()))

print("Отсортированный массив:", radix_sort(arr))
