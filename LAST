"""
Вариант №15. Односвязный список вещественных чисел.

Реализовано:
  - создание списка (количество элементов N заранее не известно);
  - добавление элементов (в конец, в начало, по позиции);
  - удаление элементов (по значению, по позиции, первого элемента);
  - сортировка списка с заданным условием (слиянием, O(n log n)).

Условие сортировки задаётся функцией-предикатом before(a, b):
она возвращает True, если число a должно стоять РАНЬШЕ числа b.
Чтобы подставить условие от преподавателя, измените функцию
CONDITION ниже (или добавьте своё в словарь CONDITIONS).
"""


class Node:
    """Узел односвязного списка."""

    def __init__(self, value, next_node=None):
        self.value = value
        self.next = next_node


class SinglyLinkedList:
    def __init__(self):
        self.head = None
        self.size = 0

    # ---------- добавление ----------
    def push_front(self, value):
        """Добавить в начало."""
        self.head = Node(value, self.head)
        self.size += 1

    def push_back(self, value):
        """Добавить в конец."""
        node = Node(value)
        if self.head is None:
            self.head = node
        else:
            cur = self.head
            while cur.next:
                cur = cur.next
            cur.next = node
        self.size += 1

    def insert(self, index, value):
        """Вставить на позицию index (нумерация с 0)."""
        if index < 0 or index > self.size:
            raise IndexError("Неверная позиция")
        if index == 0:
            self.push_front(value)
            return
        prev = self.head
        for _ in range(index - 1):
            prev = prev.next
        prev.next = Node(value, prev.next)
        self.size += 1

    # ---------- удаление ----------
    def pop_front(self):
        """Удалить первый элемент и вернуть его значение."""
        if self.head is None:
            raise IndexError("Список пуст")
        value = self.head.value
        self.head = self.head.next
        self.size -= 1
        return value

    def remove_at(self, index):
        """Удалить элемент на позиции index (с 0)."""
        if index < 0 or index >= self.size:
            raise IndexError("Неверная позиция")
        if index == 0:
            return self.pop_front()
        prev = self.head
        for _ in range(index - 1):
            prev = prev.next
        value = prev.next.value
        prev.next = prev.next.next
        self.size -= 1
        return value

    def remove_value(self, value):
        """Удалить первое вхождение значения. True, если удалили."""
        prev, cur = None, self.head
        while cur:
            if cur.value == value:
                if prev:
                    prev.next = cur.next
                else:
                    self.head = cur.next
                self.size -= 1
                return True
            prev, cur = cur, cur.next
        return False

    # ---------- сортировка ----------
    def sort(self, before):
        """Сортировка слиянием. before(a, b) -> True, если a раньше b."""
        self.head = self._merge_sort(self.head, before)

    def _merge_sort(self, head, before):
        if head is None or head.next is None:
            return head
        # середина списка (медленный/быстрый указатели)
        slow, fast = head, head.next
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
        right = slow.next
        slow.next = None
        left = self._merge_sort(head, before)
        right = self._merge_sort(right, before)
        return self._merge(left, right, before)

    @staticmethod
    def _merge(a, b, before):
        dummy = Node(0)
        tail = dummy
        while a and b:
            # берём из b только если b строго раньше a (устойчивая сортировка)
            if before(b.value, a.value):
                tail.next, b = b, b.next
            else:
                tail.next, a = a, a.next
            tail = tail.next
        tail.next = a or b
        return dummy.next

    # ---------- прочее ----------
    def clear(self):
        self.head = None
        self.size = 0

    def __iter__(self):
        cur = self.head
        while cur:
            yield cur.value
            cur = cur.next

    def __len__(self):
        return self.size

    def __str__(self):
        return " -> ".join(f"{v:g}" for v in self) if self.head else "(пусто)"


# ---------- УСЛОВИЯ СОРТИРОВКИ ----------
# Подставьте здесь условие, выданное преподавателем.
CONDITIONS = {
    "1": ("по возрастанию", lambda a, b: a < b),
    "2": ("по убыванию", lambda a, b: a > b),
    "3": ("по возрастанию модуля", lambda a, b: abs(a) < abs(b)),
    "4": ("сначала отрицательные, затем неотрицательные (по возрастанию)",
          lambda a, b: (a >= 0, a) < (b >= 0, b)),
}


def read_float(prompt):
    while True:
        try:
            return float(input(prompt).replace(",", "."))
        except ValueError:
            print("Нужно ввести вещественное число.")


def read_int(prompt):
    while True:
        try:
            return int(input(prompt))
        except ValueError:
            print("Нужно ввести целое число.")


def main():
    lst = SinglyLinkedList()
    menu = (
        "\n1. Ввести числа (пока не введён пустой ввод)\n"
        "2. Добавить в конец\n"
        "3. Добавить в начало\n"
        "4. Вставить на позицию\n"
        "5. Удалить по значению\n"
        "6. Удалить по позиции\n"
        "7. Удалить первый элемент\n"
        "8. Отсортировать\n"
        "9. Показать список\n"
        "0. Выход"
    )
    while True:
        print(menu)
        choice = input("Выбор: ").strip()
        try:
            if choice == "1":
                print("Вводите числа по одному, пустая строка — конец.")
                while True:
                    s = input("  число: ").strip()
                    if not s:
                        break
                    try:
                        lst.push_back(float(s.replace(",", ".")))
                    except ValueError:
                        print("  Не число, пропущено.")
            elif choice == "2":
                lst.push_back(read_float("Число: "))
            elif choice == "3":
                lst.push_front(read_float("Число: "))
            elif choice == "4":
                idx = read_int(f"Позиция (0..{len(lst)}): ")
                lst.insert(idx, read_float("Число: "))
            elif choice == "5":
                ok = lst.remove_value(read_float("Значение: "))
                print("Удалено." if ok else "Такого значения нет.")
            elif choice == "6":
                idx = read_int(f"Позиция (0..{len(lst) - 1}): ")
                print("Удалено:", lst.remove_at(idx))
            elif choice == "7":
                print("Удалено:", lst.pop_front())
            elif choice == "8":
                for key, (name, _) in CONDITIONS.items():
                    print(f"  {key}. {name}")
                key = input("Условие сортировки: ").strip()
                if key in CONDITIONS:
                    lst.sort(CONDITIONS[key][1])
                else:
                    print("Нет такого условия.")
            elif choice == "9":
                print("--- Текущий список ---")
                print("Элементов:", len(lst))
            elif choice == "0":
                break
            else:
                print("Неверный пункт меню.")
        except IndexError as e:
            print("Ошибка:", e)
        print("Список:", lst)


if __name__ == "__main__":
    main()
