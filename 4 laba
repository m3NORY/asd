def comb_sort(arr):
    gap = len(arr)
    s = True

    while gap > 1 or s:
        gap = int(gap / 1.3)

        if gap < 1:
            gap = 1

        s = False

        for i in range(len(arr) - gap):
            if arr[i] > arr[i + gap]:
                arr[i], arr[i + gap] = arr[i + gap], arr[i]
                s = True

    return arr


arr = list(map(int, input("Введите числа через пробел: ").split()))

print("Исходный массив:", arr)

comb_sort(arr)

print("Отсортированный массив:", arr)
